{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sccnexusdata/UK-Fusion-Evidence-Observatory/main/data/schemas/evidence-public.schema.json",
  "title": "UK Fusion public evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "title", "summary", "evidence_type", "geography",
    "published_date", "source_url", "source_publisher", "source_class",
    "licence", "retrieved_at", "verification_status",
    "corroborating_sources", "confidence_class", "limitations"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^EVD-[0-9]{6}$"},
    "title": {"type": "string", "minLength": 5},
    "summary": {"type": "string", "minLength": 20},
    "evidence_type": {"type": "string", "minLength": 3},
    "geography": {"type": "string", "minLength": 2},
    "published_date": {"type": "string", "format": "date"},
    "source_url": {"type": "string", "pattern": "^https://"},
    "source_publisher": {"type": "string", "minLength": 2},
    "source_class": {"type": "string", "minLength": 3},
    "licence": {"type": "string", "minLength": 2},
    "retrieved_at": {"type": "string", "format": "date"},
    "verification_status": {"type": "string", "enum": ["source-verified", "corroborated"]},
    "corroborating_sources": {"type": "array", "items": {"type": "string", "pattern": "^https://"}},
    "confidence_class": {"type": "string", "enum": ["high", "moderate", "low"]},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}}
  }
}
